---
type Props = { color?: "white" | "black"; backgroundColor?: "blue" | "white" };

const { color, backgroundColor } = Astro.props;
const colors = {
  white: "#ffffff",
  black: "#000000",
  blue: "#293f7d",
} satisfies Record<
  Exclude<typeof color | typeof backgroundColor, undefined>,
  string
>;
---

<div
  class="wrapper"
  style={{
    backgroundColor: colors[backgroundColor ?? "blue"],
    color: colors[color ?? "white"],
  }}
>
  <div>
    „<slot />“
  </div>
</div>
<style lang="scss">
  .wrapper {
    display: flex;
    flex-direction: row;
    justify-content: center;
    > div {
      padding: var(--padding-lg);
      max-width: var(--max-page-width);
      box-sizing: border-box;
      font-size: 32px;
      font-style: italic;
      text-align: center;
    }
  }
</style>
