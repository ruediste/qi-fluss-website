---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

type Props = {
  title: string;
  description: string;
  keywords: string[];
  mainStyle?: Partial<CSSStyleProperties>;
};

const { title, description, keywords, mainStyle } = Astro.props;

const combinedStyle = {
  display: "flex",
  flexDirection: "column",
  alignItems: "stretch",
  ...mainStyle,
} satisfies Partial<CSSStyleProperties>;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} keywords={keywords} />
    <style></style>
  </head>

  <body>
    <Header />
    <main style={combinedStyle}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
